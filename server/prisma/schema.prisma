datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model Book {
  id          Int      @id @default(autoincrement())
  title       String
  level       String
  description String?
  units       Unit[]
}

model Unit {
  id          Int      @id @default(autoincrement())
  bookId      Int
  book        Book     @relation(fields: [bookId], references: [id])
  unitNumber  Int
  title       String
  words       Word[]

  @@unique([bookId, unitNumber])
}

model Word {
  id              Int      @id @default(autoincrement())
  unitId          Int
  unit            Unit     @relation(fields: [unitId], references: [id])
  wordNumber      Int
  kanji           String
  hiragana        String
  hanViet         String?
  meaning         String
  exampleSentence String?
  exampleMeaning  String?
  notes           String?
  wordType        String? // noun, i_adj, na_adj, verb, vi, vt, adv, other
  progress        LearningProgress?

  @@unique([unitId, wordNumber])
}

model LearningProgress {
  id             Int      @id @default(autoincrement())
  wordId         Int      @unique
  word           Word     @relation(fields: [wordId], references: [id])
  status         String   @default("new") // new, learning, weak, mastered
  correctCount   Int      @default(0)
  wrongCount     Int      @default(0)
  lastReviewedAt DateTime @default(now())
  masteryLevel   Int      @default(0)
}
